{
  "expo": {
    "name": "100 and Done",
    "slug": "hundredanddone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hundredanddone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hundredanddone.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "100 and Done uses your location to find doctors, clinics and hospitals near you and to set your address for home visits.",
        "NSPhotoLibraryUsageDescription": "Allow 100 and Done to access your photos so you can upload a profile photo, clinic logo or verification documents.",
        "NSCameraUsageDescription": "Allow 100 and Done to use your camera to capture verification documents."
      }
    },
    "android": {
      "package": "com.hundredanddone.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "100 and Done uses your location to find nearby providers and to set the address for home visits.",
          "locationWhenInUsePermission": "100 and Done uses your location to find nearby providers and to set the address for home visits.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 100 and Done to access your photos so you can upload a profile photo, clinic logo or verification documents.",
          "cameraPermission": "Allow 100 and Done to use your camera to capture verification documents."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_REVERSED_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-stallion-plugin",
        {
          "projectId": "REPLACE_WITH_STALLION_PROJECT_ID",
          "appToken": "spb_REPLACE_WITH_STALLION_APP_TOKEN",
          "publicSigningKey": "REPLACE_WITH_STALLION_PUBLIC_KEY"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f78c3a0-d440-4826-bc53-6d2adc7d98ec"
      }
    },
    "owner": "hundredanddones-team"
  }
}
